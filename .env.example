# Anthropic API key — required for narrative generation
ANTHROPIC_API_KEY=sk-ant-...

# Path to SQLite database (default: ~/.receipt/receipt.db)
RECEIPT_DB_PATH=~/.receipt/receipt.db

# FastAPI server settings
RECEIPT_API_HOST=0.0.0.0
RECEIPT_API_PORT=8000

# Embedding model cache directory (default: ~/.receipt/models)
RECEIPT_MODEL_CACHE=~/.receipt/models

# Log level: DEBUG | INFO | WARNING | ERROR
RECEIPT_LOG_LEVEL=INFO
